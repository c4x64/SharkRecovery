# Shark Recovery system properties for SM-E225F
# Samsung Galaxy F22

# Basic properties
ro.product.model=SM-E225F
ro.product.name=f22
ro.product.device=f22
ro.product.brand=samsung
ro.product.manufacturer=samsung

# Shark Recovery branding
ro.shark.recovery=1
ro.shark.version=1.0
ro.shark.device=f22
ro.shark.recovery.name=Shark Recovery

# Recovery properties
ro.build.type=eng
ro.build.version.release=11
ro.build.version.sdk=30
ro.build.version.codename=REL

# TWRP specific
persist.sys.usb.config=mtp,adb
persist.service.adb.enable=1
persist.sys.timezone=UTC
persist.sys.language=en

# KernelSU properties
ro.ksu.enabled=1
ro.ksu.lkm=1
ro.ksu.version=1.0

# Device specific
ro.build.characteristics=nosdcard
ro.hardware.keystore=mdfpp
ro.hardware.offcharger=true

# MediaTek
ro.mediatek.platform=mt6769t
ro.mediatek.board=mt6769t
ro.mediatek.chip=mt6769t
