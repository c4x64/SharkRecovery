# KernelSU Configuration for SM-E225F
# Shark Recovery

# KernelSU core options
CONFIG_KSU=y
CONFIG_KSU_SHOW_BROKEN=y
CONFIG_KSU_DEBUG=n
CONFIG_KSU_KPM=y
CONFIG_KSU_SUSFS=y

# SM-E225F specific
CONFIG_KSU_ARCH="arm64"
CONFIG_KSU_KERNEL_VERSION="4.19"
CONFIG_KSU_PLATFORM="mt6769t"

# Build options
CONFIG_KSU_USERSPACE=y
CONFIG_KSU_MANAGER=y
